{
  "name": "cozy-spider",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && node tools/deploy.mjs",
    "deploy:api": "node tools/deploy-api.mjs",
    "typecheck": "tsc --noEmit",
    "gen:assets": "python tools/gen_procedural_assets.py",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@rollup/pluginutils": "^5.4.0",
    "@types/node": "^20.19.43",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-glsl": "^1.3.0",
    "vitest": "^2.1.9"
  }
}
